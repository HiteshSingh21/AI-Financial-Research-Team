# ── Required ──
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional ──
TAVILY_API_KEY=your-tavily-api-key-here
OPENAI_API_KEY=sk-...

# ── Database (local dev uses SQLite by default; Docker uses Postgres) ──
DATABASE_URL=sqlite:///./financial_analyst.db

# ── Docker Postgres Credentials ──
POSTGRES_USER=financial_ai
POSTGRES_PASSWORD=financial_ai_pass

# ── Model Selection ──
GEMINI_MODEL=gemini-1.5-flash
